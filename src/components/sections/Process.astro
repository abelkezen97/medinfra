---
import { stages } from '../../data/company';
interface Props { highlight?: string[] }
const { highlight = [] } = Astro.props;
---
<ol class="relative grid gap-px overflow-hidden rounded-[24px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal>
  {stages.map((s) => {
    const on = highlight.length === 0 || highlight.includes(s.num);
    return (
      <li
        class:list={[
          'stage group relative flex flex-col bg-paper p-8 transition-[background-color] duration-500 hover:bg-white md:p-9',
          !on && '[&>*]:opacity-40',
        ]}
      >
        <div class="flex items-center gap-4">
          <span class:list={[
            'font-display text-[3.4rem] leading-none tracking-[-0.04em]',
            on && highlight.length ? 'text-accent' : 'text-cobalt',
          ]}>{s.num}</span>
          <span class="h-px flex-1 bg-line transition-colors duration-500 group-hover:bg-accent" aria-hidden="true"></span>
        </div>
        <h3 class="mt-8 text-[1.15rem] font-semibold tracking-[-0.01em] text-ink">{s.title}</h3>
        <ul class="mt-4 space-y-1.5 text-[0.93rem] text-slate">
          {s.items.map((it) => <li>{it}</li>)}
        </ul>
      </li>
    );
  })}
</ol>
