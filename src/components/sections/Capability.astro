---
import Icon from '../Icon.astro';
import { clients, deliverables } from '../../data/company';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
<section class="on-dark section-y relative isolate overflow-hidden bg-navy-950 text-white">

  <div class="container-x grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <span class="kicker kicker--dot" data-reveal>Private &amp; Government Project Capability</span>
      <H class="display-lg mt-6" data-reveal>Built for complex healthcare projects</H>
      <p class="mt-7 max-w-xl text-[1.1rem] leading-relaxed text-white/70" data-reveal>
        MedInfra is structured to work across ownership models, funding routes and approval frameworks — with the
        commercial documentation and technical rigour each one demands.
      </p>

      <div class="mt-12" data-reveal>
        <p class="font-semibold text-[0.75rem] uppercase tracking-[0.1em] text-white/45">Standard project deliverables</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {deliverables.map((d) => (
            <li class="rounded-full border border-white/15 bg-white/[0.04] px-4 py-2 text-[0.88rem] text-white/85">{d}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="lg:col-span-5 lg:col-start-8">
      <div class="rounded-[24px] border border-white/10 bg-white/[0.035] p-8 shadow-[0_40px_80px_-30px_rgb(0_0_0/0.6)] backdrop-blur-sm md:p-10" data-reveal>
        <p class="font-semibold text-[0.75rem] uppercase tracking-[0.1em] text-sky">Who we work with</p>
        <ul class="mt-6 divide-y divide-white/10">
          {clients.map((c) => (
            <li class="flex items-center justify-between gap-4 py-4 text-[1.02rem] text-white/85">
              {c}
              <Icon name="check" class="size-4 shrink-0 text-sky" strokeWidth={2.2} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
