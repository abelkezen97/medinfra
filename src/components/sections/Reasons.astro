---
import Icon from '../Icon.astro';
import { reasons } from '../../data/company';
---
<ul class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
  {reasons.map((r, i) => (
    <li class="group" data-reveal style={`--d:${i % 3}`}>
      <span class="grid size-14 place-items-center rounded-full border border-line text-cobalt transition-[background-color,border-color,color,transform] duration-500 ease-(--ease-spring) group-hover:scale-105 group-hover:border-accent group-hover:bg-accent group-hover:text-white">
          <Icon name={r.icon} class="size-6" />
      </span>
      <h3 class="display-sm mt-7 text-ink">{r.title}</h3>
      <p class="mt-3 max-w-sm text-[1rem] leading-relaxed text-slate">{r.text}</p>
    </li>
  ))}
</ul>
