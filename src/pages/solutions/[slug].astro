---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ScrollFilm from '../../components/ScrollFilm.astro';
import SolutionsGrid from '../../components/sections/SolutionsGrid.astro';
import Process from '../../components/sections/Process.astro';
import CtaBand from '../../components/CtaBand.astro';
import { solutions, photoUrl, type Solution } from '../../data/solutions';
import { otChapters } from '../../data/company';
import { site } from '../../data/site';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Solution };

const path = `/solutions/${s.slug}/`;
const crumbs = [
  { name: 'Solutions', path: '/solutions/' },
  { name: s.short, path },
];
const isOT = s.slug === 'modular-ot-icu';

const schema = [{
  '@type': 'Service',
  '@id': `${site.url}${path}#service`,
  name: s.title,
  serviceType: s.title,
  description: s.metaDescription,
  url: `${site.url}${path}`,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'India' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${s.title} — scope`,
    itemListElement: s.scope.map((item) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: item },
    })),
  },
}];

// Headline: second line in italics — after an em dash, from an ampersand, or the last word.
function heroLines(title: string) {
  if (title.includes(' — ')) {
    const [a, b] = title.split(' — ');
    return [a, `*${b}*`];
  }
  const amp = title.indexOf(' & ');
  if (amp > 0) return [title.slice(0, amp), `*${title.slice(amp + 1)}*`];
  const words = title.split(' ');
  return [words.slice(0, -1).join(' '), `*${words.at(-1)}*`];
}
const lines = heroLines(s.title);
---
<Layout
  title={s.metaTitle}
  description={s.metaDescription}
  breadcrumbs={crumbs}
  schema={schema}
  image={isOT ? '/og/medinfra-ot-icu.jpg' : undefined}
>
  <PageHero kicker="Our Solutions" lines={lines} lede={s.summary} breadcrumbs={crumbs} image={photoUrl(s.photo, 1600, 610)}>
    <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:4">
      <a href="/contact/" class="btn btn-primary">
        Discuss this scope
        <span class="btn-arrow"><Icon name="arrow" class="size-3.5" strokeWidth={2} /></span>
      </a>
      <a href="#scope" class="btn btn-ghost">View scope</a>
    </div>
  </PageHero>

  <!-- Overview + scope -->
  <section class="section-y bg-paper">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <span class="kicker" data-reveal>Overview</span>
        <h2 class="display-md mt-6 text-ink" data-reveal>{s.title}</h2>
        <div class="mt-8 space-y-6">
          {s.intro.map((p) => <p class="lede !max-w-none" data-reveal>{p}</p>)}
        </div>
      </div>

      <div id="scope" class="scroll-mt-28 lg:col-span-5 lg:col-start-8">
        <div class="rounded-[24px] border border-line bg-white p-8 shadow-(--shadow-elevated) md:p-10" data-reveal>
          <div class="flex items-center justify-between">
            <p class="font-semibold text-[0.75rem] uppercase tracking-[0.1em] text-cobalt">Scope of work</p>
            <span class="grid size-11 place-items-center rounded-xl bg-ivory text-cobalt"><Icon name={s.icon} class="size-5" /></span>
          </div>
          <ul class="mt-6 divide-y divide-line">
            {s.scope.map((item) => (
              <li class="flex items-center gap-4 py-3.5 text-[1rem] text-ink">
                <Icon name="check" class="size-4 shrink-0 text-accent" strokeWidth={2.2} />
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {isOT && (
    <ScrollFilm
      id="ot-film"
      name="ot"
      frames={141}
      variant="slot"
      length={360}
      label="Walkthrough of a modular operation theatre and ICU"
      chapters={otChapters}
    >
      <div slot="intro" class="flex h-full max-w-4xl flex-col justify-center pt-[84px]">
        <span class="kicker kicker--dot">Inside a modular OT</span>
        <h2 class="display-xl mt-7 text-white">Precision where it <em class="text-sky">matters most.</em></h2>
      </div>
    </ScrollFilm>
  )}

  <!-- Where it fits -->
  <section class="section-y bg-ivory">
    <div class="container-x">
      <div class="mb-14 grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <span class="kicker" data-reveal>Where it fits</span>
          <h2 class="display-lg mt-6 text-ink" data-reveal>Part of one <em class="text-cobalt">continuous</em> delivery chain</h2>
        </div>
        <p class="lede lg:col-span-5" data-reveal>
          Highlighted stages show where {s.short} work happens inside MedInfra’s eight-stage delivery model.
        </p>
      </div>
      <Process highlight={s.stages} />
    </div>
  </section>

  <!-- Related -->
  <section class="section-y bg-paper">
    <div class="container-x">
      <div class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="kicker" data-reveal>Related solutions</span>
          <h2 class="display-lg mt-6 text-ink" data-reveal>Often delivered together</h2>
        </div>
        <a href="/solutions/" class="link-u text-cobalt" data-reveal>All nine solutions <Icon name="arrow" class="size-4" strokeWidth={2} /></a>
      </div>
      <SolutionsGrid only={s.related} />
    </div>
  </section>

  <CtaBand />
</Layout>
